# Optional MapLibre style override. The default is OpenFreeMap Liberty.
VITE_TURN_BY_TURN_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Optional for native builds and remote testing.
# Web dev uses the Vite /api proxy. Native iOS defaults to http://127.0.0.1:5055
# in the simulator, and native Android defaults to http://10.0.2.2:5055
# in the emulator. For a physical device, use a reachable LAN or HTTPS URL.
VITE_ROUTING_API_URL=http://192.168.1.100:5055
