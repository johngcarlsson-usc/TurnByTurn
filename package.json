{
  "name": "turn-by-turn",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/dev.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:ui": "vite --config vite.config.js --host 127.0.0.1",
    "build": "vite build --config vite.config.js",
    "preview": "vite preview --config vite.config.js",
    "mobile:sync": "npm run build && cap sync",
    "mobile:ios": "npm run mobile:sync && cap open ios",
    "mobile:android": "npm run mobile:sync && cap open android",
    "mobile:run:ios": "npm run mobile:sync && cap run ios",
    "mobile:run:android": "npm run mobile:sync && cap run android"
  },
  "dependencies": {
    "@capacitor/core": "8.5.3",
    "@capacitor/geolocation": "8.2.4",
    "@mantine/core": "^8.3.16",
    "@mantine/hooks": "^8.3.16",
    "@stadiamaps/ferrostar": "^0.58.0",
    "@tabler/icons-react": "^3.40.0",
    "maplibre-gl": "^6.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/cli": "8.4.1",
    "@capacitor/ios": "8.5.3",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.4"
  }
}
